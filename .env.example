# Copy this file to .env and fill in real values ONLY once you
# have them. The app runs completely fine with .env missing or
# empty — it falls back to a local file for the database and a
# local log for hospital alerts (see data/ folder after running).
#
# Fill in Supabase first (2-minute signup, no telephony wait):
SUPABASE_URL=
SUPABASE_KEY=

# Fill in Twilio once your India number / WhatsApp sandbox are
# sorted. Until then, leave these blank — hospital "alerts" will
# just be logged locally so you can see exactly what would have
# been sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_IVR_NUMBER=
HOSPITAL_PHONE_NUMBER=
